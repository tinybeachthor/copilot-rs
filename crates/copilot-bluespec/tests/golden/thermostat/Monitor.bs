package Monitor where

import MonitorIfc

-- | One step of the monitor per clock cycle.
--
-- The rule below is the whole monitor: it fires unconditionally, so a step
-- takes one cycle whatever the data is. Registers change at the clock edge
-- and the rule reads them as they were before it, which is what keeps the
-- compute and commit phases apart without any sequencing.
mkMonitor :: (IsModule m c) => MonitorIfc -> m Empty
mkMonitor ifc =
  module
    -- Stream 0: 1 value of Bool.
    s0_0 :: Reg Bool <- mkReg False

    rules
      "step": when True ==> do
        -- Phase 1: read each external variable exactly once.
        x_temperature <- ifc.temperature

        -- Phases 2 and 3: name every subexpression once. These are wires, not
        -- state, so naming a shared one is what makes it shared hardware.
        let e0 :: Int 16
            e0 = x_temperature
        let e1 :: Int 16
            e1 = 180
        let e2 :: Bool
            e2 = e0 < e1
        let e3 :: Int 16
            e3 = 210
        let e4 :: Bool
            e4 = e0 > e3
        let e5 :: Bool
            e5 = s0_0
        let e6 :: Bool
            e6 = True
        let e7 :: Bool
            e7 = False
        let e8 :: Bool
            e8 = if e4 then e7 else e5
        let e9 :: Bool
            e9 = if e2 then e6 else e8
        let e10 :: Bool
            e10 = not e5
        let e11 :: Bool
            e11 = e2 && e10
        let e12 :: Bool
            e12 = e4 && e5

        -- Phase 2: report observers, then fire triggers.
        ifc.observe_temperature e0
        ifc.observe_heating e5
        if e11 then ifc.heat_on e0 else noAction
        if e12 then ifc.heat_off e0 else noAction

        -- Phase 4: commit. The new value overwrites the slot holding the value
        -- that has just expired.
