--
-- State: 160 bits across 5 registers. Work per step: 6 operations, all
-- combinational, so a step is one cycle whatever the data is.
--
-- The bit count is what this specification's buffers hold. It is not the area
-- bsc synthesises, and nothing in copilot-rs checks it against one.
package Monitor where

import Vector

import MonitorIfc

-- | One step of the monitor per clock cycle.
--
-- The rule below is the whole monitor: it fires unconditionally, so a step
-- takes one cycle whatever the data is. Registers change at the clock edge
-- and the rule reads them as they were before it, which is what keeps the
-- compute and commit phases apart without any sequencing.
mkMonitor :: (IsModule m c) => MonitorIfc -> m Empty
mkMonitor ifc =
  module
    -- Stream 0: 1 value of UInt 32.
    s0_0 :: Reg (UInt 32) <- mkReg 0

    -- Stream 1: 3 values of UInt 32.
    s1_0 :: Reg (UInt 32) <- mkReg 0
    s1_1 :: Reg (UInt 32) <- mkReg 0
    s1_2 :: Reg (UInt 32) <- mkReg 0
    s1_idx :: Reg (UInt 32) <- mkReg 0

    let s1 :: Vector 3 (Reg (UInt 32))
        s1 = cons s1_0 (cons s1_1 (cons s1_2 nil))

    rules
      "step": when True ==> do
        -- Phases 2 and 3: name every subexpression once. These are wires, not
        -- state, so naming a shared one is what makes it shared hardware.
        let e0 :: UInt 32
            e0 = s0_0
        let e1 :: UInt 32
            e1 = 1
        let e2 :: UInt 32
            e2 = e0 + e1
        let e3 :: UInt 32
            e3 = select (readVReg s1) s1_idx
        let e4 :: UInt 32
            e4 = select (readVReg s1) (if s1_idx + 1 >= 3 then s1_idx + 1 - 3 else s1_idx + 1)
        let e5 :: UInt 32
            e5 = select (readVReg s1) (if s1_idx + 2 >= 3 then s1_idx + 2 - 3 else s1_idx + 2)

        -- Phase 2: report observers, then fire triggers.
        ifc.observe_now e3
        ifc.observe_one_ago e4
        ifc.observe_two_ago e5

        -- Phase 4: commit. The new value overwrites the slot holding the value
        -- that has just expired.
        s0_0 := e2
        writeVReg s1 (update (readVReg s1) s1_idx e0)
        s1_idx := if s1_idx + 1 >= 3 then 0 else s1_idx + 1
